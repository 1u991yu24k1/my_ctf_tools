FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    clang++ \
    lld \
    llvm \
    llvm-dev \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-pip \
    python3-venv \
    pkg-config \
    gdb \
    lldb \
    valgrind \
    afl++ \
    ripgrep \
    jq \
    file \
    less \
    ca-certificates \
    corpus2libfuzzer \
    && rm -rf /var/lib/apt/lists/*

ENV CC=clang
ENV CXX=clang++
ENV ASAN_OPTIONS=abort_on_error=1:symbolize=1:detect_leaks=1
ENV UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
ENV LLVM_SYMBOLIZER_PATH=/usr/bin/llvm-symbolizer

WORKDIR /work
